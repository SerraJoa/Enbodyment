<?xml version="1.0"?>
<!--
  Maniquí humanoide canònic — font de veritat de l'ESTRUCTURA.
  ~20 joints, peu de dos segments, arrel = pelvis.

  FILOSOFIA DE CONTROL (veure docs/architecture.md):
  Els joints NO porten cap controlador amb objectiu de postura. Porten només
  propietats PASSIVES: stiffness (moll virtual) i damping (esmorteïdor). Això és
  el "substrat" — el cos té elasticitat i inèrcia, i prou. Cap agent que vulgui
  "estar dret". El comportament (equilibri, contrapès, postura anticipatòria)
  emergeix de la política entrenada sobre aquest substrat, no d'aquí.

  Masses i inèrcies: aproximades a un humà de ~70 kg. Els braços porten massa
  suficient per permetre contrapès real (requisit explícit de disseny).
  Inèrcies calculades com a caixes/cilindres equivalents; afinar amb dades reals
  quan es tingui el maniquí físic.
-->
<robot name="humanoid">

  <!-- ============ MATERIALS (només visual, flat-shaded) ============ -->
  <material name="grey"><color rgba="0.6 0.6 0.6 1"/></material>

  <!-- ==================== ARREL: PELVIS ==================== -->
  <link name="pelvis">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="11.0"/>
      <inertia ixx="0.10" iyy="0.09" izz="0.08" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0"/>
      <geometry><box size="0.20 0.28 0.14"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <geometry><box size="0.20 0.28 0.14"/></geometry>
    </collision>
  </link>

  <!-- ==================== COLUMNA ==================== -->
  <link name="spine">
    <inertial><mass value="8.0"/>
      <inertia ixx="0.06" iyy="0.05" izz="0.04" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><origin xyz="0 0 0.10"/><geometry><box size="0.18 0.24 0.20"/></geometry>
      <material name="grey"/></visual>
    <collision><origin xyz="0 0 0.10"/><geometry><box size="0.18 0.24 0.20"/></geometry></collision>
  </link>
  <joint name="spine" type="revolute">
    <parent link="pelvis"/><child link="spine"/>
    <origin xyz="0 0 0.08"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.6" upper="0.8" effort="200" velocity="10"/>
    <dynamics damping="4.0" friction="1.0"/>
  </joint>

  <link name="chest">
    <inertial><mass value="14.0"/>
      <inertia ixx="0.12" iyy="0.10" izz="0.09" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><origin xyz="0 0 0.12"/><geometry><box size="0.22 0.30 0.24"/></geometry>
      <material name="grey"/></visual>
    <collision><origin xyz="0 0 0.12"/><geometry><box size="0.22 0.30 0.24"/></geometry></collision>
  </link>
  <joint name="chest" type="revolute">
    <parent link="spine"/><child link="chest"/>
    <origin xyz="0 0 0.22"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.4" upper="0.5" effort="200" velocity="10"/>
    <dynamics damping="4.0" friction="1.0"/>
  </joint>

  <!-- ==================== COLL + CAP ==================== -->
  <link name="neck">
    <inertial><mass value="1.0"/>
      <inertia ixx="0.005" iyy="0.005" izz="0.004" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><origin xyz="0 0 0.05"/><geometry><cylinder radius="0.045" length="0.10"/></geometry>
      <material name="grey"/></visual>
    <collision><origin xyz="0 0 0.05"/><geometry><cylinder radius="0.045" length="0.10"/></geometry></collision>
  </link>
  <joint name="neck" type="revolute">
    <parent link="chest"/><child link="neck"/>
    <origin xyz="0 0 0.26"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.7" upper="0.7" effort="30" velocity="10"/>
    <dynamics damping="1.0" friction="0.2"/>
  </joint>

  <link name="head">
    <inertial><mass value="4.5"/>
      <inertia ixx="0.02" iyy="0.02" izz="0.02" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><origin xyz="0 0 0.09"/><geometry><sphere radius="0.10"/></geometry>
      <material name="grey"/></visual>
    <collision><origin xyz="0 0 0.09"/><geometry><sphere radius="0.10"/></geometry></collision>
  </link>
  <joint name="head" type="fixed">
    <parent link="neck"/><child link="head"/>
    <origin xyz="0 0 0.10"/>
  </joint>

  <!-- ==================== BRAÇ ESQUERRE ==================== -->
  <!-- Massa deliberadament suficient per a contrapès real -->
  <link name="left_upper_arm">
    <inertial><mass value="2.2"/>
      <inertia ixx="0.013" iyy="0.013" izz="0.003" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><origin xyz="0 0 -0.14"/><geometry><cylinder radius="0.045" length="0.28"/></geometry>
      <material name="grey"/></visual>
    <collision><origin xyz="0 0 -0.14"/><geometry><cylinder radius="0.045" length="0.28"/></geometry></collision>
  </link>
  <joint name="left_shoulder" type="revolute">
    <parent link="chest"/><child link="left_upper_arm"/>
    <origin xyz="0 0.20 0.22"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.0" upper="3.0" effort="80" velocity="12"/>
    <dynamics damping="1.5" friction="0.3"/>
  </joint>

  <link name="left_forearm">
    <inertial><mass value="1.6"/>
      <inertia ixx="0.009" iyy="0.009" izz="0.002" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><origin xyz="0 0 -0.13"/><geometry><cylinder radius="0.038" length="0.26"/></geometry>
      <material name="grey"/></visual>
    <collision><origin xyz="0 0 -0.13"/><geometry><cylinder radius="0.038" length="0.26"/></geometry></collision>
  </link>
  <joint name="left_elbow" type="revolute">
    <parent link="left_upper_arm"/><child link="left_forearm"/>
    <origin xyz="0 0 -0.28"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="2.6" effort="60" velocity="12"/>
    <dynamics damping="1.0" friction="0.2"/>
  </joint>

  <link name="left_hand">
    <inertial><mass value="0.5"/>
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><origin xyz="0 0 -0.05"/><geometry><box size="0.05 0.09 0.10"/></geometry>
      <material name="grey"/></visual>
    <collision><origin xyz="0 0 -0.05"/><geometry><box size="0.05 0.09 0.10"/></geometry></collision>
  </link>
  <joint name="left_wrist" type="revolute">
    <parent link="left_forearm"/><child link="left_hand"/>
    <origin xyz="0 0 -0.26"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.0" upper="1.0" effort="20" velocity="12"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <!-- ==================== BRAÇ DRET ==================== -->
  <link name="right_upper_arm">
    <inertial><mass value="2.2"/>
      <inertia ixx="0.013" iyy="0.013" izz="0.003" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><origin xyz="0 0 -0.14"/><geometry><cylinder radius="0.045" length="0.28"/></geometry>
      <material name="grey"/></visual>
    <collision><origin xyz="0 0 -0.14"/><geometry><cylinder radius="0.045" length="0.28"/></geometry></collision>
  </link>
  <joint name="right_shoulder" type="revolute">
    <parent link="chest"/><child link="right_upper_arm"/>
    <origin xyz="0 -0.20 0.22"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.0" upper="3.0" effort="80" velocity="12"/>
    <dynamics damping="1.5" friction="0.3"/>
  </joint>

  <link name="right_forearm">
    <inertial><mass value="1.6"/>
      <inertia ixx="0.009" iyy="0.009" izz="0.002" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><origin xyz="0 0 -0.13"/><geometry><cylinder radius="0.038" length="0.26"/></geometry>
      <material name="grey"/></visual>
    <collision><origin xyz="0 0 -0.13"/><geometry><cylinder radius="0.038" length="0.26"/></geometry></collision>
  </link>
  <joint name="right_elbow" type="revolute">
    <parent link="right_upper_arm"/><child link="right_forearm"/>
    <origin xyz="0 0 -0.28"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="2.6" effort="60" velocity="12"/>
    <dynamics damping="1.0" friction="0.2"/>
  </joint>

  <link name="right_hand">
    <inertial><mass value="0.5"/>
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><origin xyz="0 0 -0.05"/><geometry><box size="0.05 0.09 0.10"/></geometry>
      <material name="grey"/></visual>
    <collision><origin xyz="0 0 -0.05"/><geometry><box size="0.05 0.09 0.10"/></geometry></collision>
  </link>
  <joint name="right_wrist" type="revolute">
    <parent link="right_forearm"/><child link="right_hand"/>
    <origin xyz="0 0 -0.26"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.0" upper="1.0" effort="20" velocity="12"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <!-- ==================== CAMA ESQUERRA ==================== -->
  <link name="left_thigh">
    <inertial><mass value="7.0"/>
      <inertia ixx="0.11" iyy="0.11" izz="0.02" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><origin xyz="0 0 -0.21"/><geometry><cylinder radius="0.07" length="0.42"/></geometry>
      <material name="grey"/></visual>
    <collision><origin xyz="0 0 -0.21"/><geometry><cylinder radius="0.07" length="0.42"/></geometry></collision>
  </link>
  <joint name="left_hip" type="revolute">
    <parent link="pelvis"/><child link="left_thigh"/>
    <origin xyz="0 0.10 -0.07"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0" upper="1.2" effort="250" velocity="12"/>
    <dynamics damping="5.0" friction="1.0"/>
  </joint>

  <link name="left_shin">
    <inertial><mass value="3.5"/>
      <inertia ixx="0.05" iyy="0.05" izz="0.008" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><origin xyz="0 0 -0.20"/><geometry><cylinder radius="0.05" length="0.40"/></geometry>
      <material name="grey"/></visual>
    <collision><origin xyz="0 0 -0.20"/><geometry><cylinder radius="0.05" length="0.40"/></geometry></collision>
  </link>
  <joint name="left_knee" type="revolute">
    <parent link="left_thigh"/><child link="left_shin"/>
    <origin xyz="0 0 -0.42"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.6" upper="0.0" effort="250" velocity="12"/>
    <dynamics damping="4.0" friction="0.8"/>
  </joint>

  <!-- Peu de dos segments: retropeu -->
  <link name="left_foot">
    <inertial><mass value="0.9"/>
      <inertia ixx="0.002" iyy="0.004" izz="0.004" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><origin xyz="0.04 0 -0.03"/><geometry><box size="0.14 0.09 0.05"/></geometry>
      <material name="grey"/></visual>
    <collision><origin xyz="0.04 0 -0.03"/><geometry><box size="0.14 0.09 0.05"/></geometry></collision>
  </link>
  <joint name="left_ankle" type="revolute">
    <parent link="left_shin"/><child link="left_foot"/>
    <origin xyz="0 0 -0.40"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.9" upper="0.5" effort="150" velocity="12"/>
    <dynamics damping="3.0" friction="0.5"/>
  </joint>

  <!-- Peu de dos segments: avantpeu (push-off) -->
  <link name="left_forefoot">
    <inertial><mass value="0.4"/>
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><origin xyz="0.05 0 -0.02"/><geometry><box size="0.10 0.09 0.03"/></geometry>
      <material name="grey"/></visual>
    <collision><origin xyz="0.05 0 -0.02"/><geometry><box size="0.10 0.09 0.03"/></geometry></collision>
  </link>
  <joint name="left_forefoot" type="revolute">
    <parent link="left_foot"/><child link="left_forefoot"/>
    <origin xyz="0.11 0 -0.03"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.5" upper="0.7" effort="80" velocity="12"/>
    <dynamics damping="1.5" friction="0.3"/>
  </joint>

  <!-- ==================== CAMA DRETA ==================== -->
  <link name="right_thigh">
    <inertial><mass value="7.0"/>
      <inertia ixx="0.11" iyy="0.11" izz="0.02" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><origin xyz="0 0 -0.21"/><geometry><cylinder radius="0.07" length="0.42"/></geometry>
      <material name="grey"/></visual>
    <collision><origin xyz="0 0 -0.21"/><geometry><cylinder radius="0.07" length="0.42"/></geometry></collision>
  </link>
  <joint name="right_hip" type="revolute">
    <parent link="pelvis"/><child link="right_thigh"/>
    <origin xyz="0 -0.10 -0.07"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0" upper="1.2" effort="250" velocity="12"/>
    <dynamics damping="5.0" friction="1.0"/>
  </joint>

  <link name="right_shin">
    <inertial><mass value="3.5"/>
      <inertia ixx="0.05" iyy="0.05" izz="0.008" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><origin xyz="0 0 -0.20"/><geometry><cylinder radius="0.05" length="0.40"/></geometry>
      <material name="grey"/></visual>
    <collision><origin xyz="0 0 -0.20"/><geometry><cylinder radius="0.05" length="0.40"/></geometry></collision>
  </link>
  <joint name="right_knee" type="revolute">
    <parent link="right_thigh"/><child link="right_shin"/>
    <origin xyz="0 0 -0.42"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.6" upper="0.0" effort="250" velocity="12"/>
    <dynamics damping="4.0" friction="0.8"/>
  </joint>

  <link name="right_foot">
    <inertial><mass value="0.9"/>
      <inertia ixx="0.002" iyy="0.004" izz="0.004" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><origin xyz="0.04 0 -0.03"/><geometry><box size="0.14 0.09 0.05"/></geometry>
      <material name="grey"/></visual>
    <collision><origin xyz="0.04 0 -0.03"/><geometry><box size="0.14 0.09 0.05"/></geometry></collision>
  </link>
  <joint name="right_ankle" type="revolute">
    <parent link="right_shin"/><child link="right_foot"/>
    <origin xyz="0 0 -0.40"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.9" upper="0.5" effort="150" velocity="12"/>
    <dynamics damping="3.0" friction="0.5"/>
  </joint>

  <link name="right_forefoot">
    <inertial><mass value="0.4"/>
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><origin xyz="0.05 0 -0.02"/><geometry><box size="0.10 0.09 0.03"/></geometry>
      <material name="grey"/></visual>
    <collision><origin xyz="0.05 0 -0.02"/><geometry><box size="0.10 0.09 0.03"/></geometry></collision>
  </link>
  <joint name="right_forefoot" type="revolute">
    <parent link="right_foot"/><child link="right_forefoot"/>
    <origin xyz="0.11 0 -0.03"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.5" upper="0.7" effort="80" velocity="12"/>
    <dynamics damping="1.5" friction="0.3"/>
  </joint>

</robot>
